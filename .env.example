BOT_TOKEN=123456:ABC-from-BotFather
DATABASE_URL=postgres://absensi:absensi@localhost:5432/absensi?sslmode=disable
GOOGLE_CREDENTIALS_FILE=service-account.json
SPREADSHEET_ID=your-spreadsheet-id
TIMEZONE=Asia/Jakarta
# First HR admin(s). Use phone numbers (they verify by sharing their contact) and/or Telegram IDs (usable immediately).
INITIAL_ADMIN_PHONES=
# Telegram IDs (from @userinfobot)
INITIAL_ADMIN_IDS=
MAX_BACKDATE_DAYS=62

# GEMINI_MODEL may list fallbacks, tried in order when a model is busy or out of quota.
# Optional: enables free-text chat ("saya sudah datang"). Get a key at https://aistudio.google.com/apikey
# Without it, only /datang, /pulang and the plain words datang/pulang work.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite,gemini-3.5-flash,gemini-flash-lite-latest

# Sent to OpenStreetMap Nominatim for reverse geocoding; their policy asks for a contact, e.g. absensi-bot/1.0 (hr@yourcompany.com)
GEOCODE_USER_AGENT=absensi-bot/1.0
